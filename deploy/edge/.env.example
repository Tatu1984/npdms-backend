# NPDMS edge server configuration.
#
#   cp .env.example .env
#   Then replace every value marked CHANGE_ME. The compose file refuses to start
#   without them rather than falling back to a default nobody changed.
#
# Generate secrets on the box:
#   openssl rand -base64 36

# --- Database (stays on this server) ---
POSTGRES_DB=npdms
POSTGRES_USER=npdms
POSTGRES_PASSWORD=CHANGE_ME

# --- Cache and sessions ---
REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=512mb

# --- Object storage for evidence files ---
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=npdms

# --- API ---
# Must be long and random. Rotating it signs every session out.
JWT_SECRET=CHANGE_ME
ENV=production

# Sessions a single officer may hold at once across devices.
MAX_CONCURRENT_SESSIONS=5

# Which interface the API listens on. 127.0.0.1 keeps it on the box (put a
# reverse proxy in front); 0.0.0.0 exposes it to the station LAN.
API_BIND=0.0.0.0

# --- External lookups ---
# Set false on an air-gapped deployment. The API then reports IP intelligence as
# unavailable instead of every client timing out against the internet.
IP_INTEL_ENABLED=true
