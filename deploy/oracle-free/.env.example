# NPDMS on Oracle Cloud Always Free (1 GB micro instance).
#
#   cp .env.example .env   and replace every CHANGE_ME
#   Generate secrets on the instance:  openssl rand -base64 36

POSTGRES_DB=npdms
POSTGRES_USER=npdms
POSTGRES_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME
# Sessions and rate-limit counters only. 64mb is ample; raising it on a 1 GB
# box takes memory from Postgres, which needs it more.
REDIS_MAXMEMORY=64mb

JWT_SECRET=CHANGE_ME
# Separate key so rotating JWT_SECRET does not invalidate historical custody
# signatures.
CUSTODY_SIGNING_KEY=CHANGE_ME

ENV=staging
MAX_CONCURRENT_SESSIONS=5

# 127.0.0.1 keeps the API on the box; put a TLS proxy in front of it.
# 0.0.0.0 exposes it directly — acceptable for a short demo, not for real data.
API_BIND=127.0.0.1

IP_INTEL_ENABLED=true
