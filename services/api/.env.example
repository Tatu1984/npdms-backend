# NPDMS API configuration
# Copy to .env and fill in real values. The API reads .env from its working directory.

# --- Required ---
DATABASE_URL=postgresql://user:password@host:5432/npdms?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Optional (defaults shown) ---
REDIS_URL=redis://localhost:6379
MINIO_BUCKET=npdms
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=
PORT=8080
ENV=development

# Concurrent sessions allowed per user (production default is 3; raise for local dev)
MAX_CONCURRENT_SESSIONS=3

# ML service endpoints (only needed when the Python services are running)
ML_FIR_CLASSIFIER_URL=http://localhost:8001
ML_SEMANTIC_SEARCH_URL=http://localhost:8002
ML_CRIME_PREDICTION_URL=http://localhost:8003
ML_OCR_URL=http://localhost:8004
